{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 FastAPI: 启动服务 (无 reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--log-level",
        "debug"
      ],
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/discover_backend",
      "python": "${workspaceFolder}/discover_backend/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/discover_backend",
        "LOG_LEVEL": "DEBUG"
      },
      // ✅ 使用内部调试控制台，避免终端冲突
      "console": "integratedTerminal"
    },
    {
      "name": "🛰️ 腾讯联网 MCP 服务 (tencent_mcp)",
      "type": "debugpy",
      "request": "launch",
      "module": "local_mcp.tencent_mcp.main",
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/discover_backend",
      "python": "${workspaceFolder}/discover_backend/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/discover_backend"
      },
      // ✅ 使用内部调试控制台
      "console": "internalConsole"
    },
    {
      "name": "🛰️ 东财 MCP 服务 (eastmoney_mcp)",
      "type": "debugpy",
      "request": "launch",
      "module": "local_mcp.eastmoney_mcp.main",
      "jinja": true,
      "justMyCode": false,
      "cwd": "${workspaceFolder}/discover_backend",
      "python": "${workspaceFolder}/discover_backend/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/discover_backend"
      },
      // ✅ 使用内部调试控制台
      "console": "internalConsole"
    },
    {
      "name": "Debug in Chrome (Vite)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/discover_frontend",
      "preLaunchTask": "dev: Vite dev server"
    },
    {
      "name": "Debug in Edge (Vite)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/discover_frontend",
      "preLaunchTask": "dev: Vite dev server"
    },
    {
      "name": "Vitest (run)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/discover_frontend/node_modules/vitest/vitest.mjs",
      "args": [
        "run"
      ],
      "cwd": "${workspaceFolder}/discover_frontend",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🧩 前后端 Dev 一起启动 (MCP + FastAPI + Vite)",
      "configurations": [
        "🛰️ 腾讯联网 MCP 服务 (tencent_mcp)",
        "🛰️ 东财 MCP 服务 (eastmoney_mcp)",
        "🚀 FastAPI: 启动服务 (无 reload)",
        "Debug in Chrome (Vite)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "1 组合启动",
        "order": 1
      }
    }
  ]
}