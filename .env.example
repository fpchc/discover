# ===== discover 根目录 .env 模板（docker compose 自动读取）=====
# 各 compose 文件的 x-common-env 对每个变量都有默认值，这里只覆盖需要改的项。
# 模板里注释掉的变量 = 走 compose 内置默认值；取消注释即覆盖。
# 注意：不要用「留空」的方式覆盖（如 DB_PASSWORD= 空值会顶掉默认值导致连接失败），
#       需要走默认就整行注释，需要覆盖就填真实值。

# ---------- LLM（必填：对话功能依赖）----------
# 多模型服务商 API Key，缺失时对话不可用
LLM_API_KEY=

# ---------- MCP / 搜索（可选）----------
# 搜索令牌：web_search 能力默认走 yuanbao_search（config/mcp-servers.yaml）
YUANBAO_SEARCH_TOKEN=
ALIBABA_SEARCH_TOKEN=

# ---------- 数据库（test 默认远程库 175.178.45.21，一般无需改）----------
# DB_HOST=175.178.45.21
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=v7Hf
# DB_DATABASE=agent_platform

# ---------- 默认模型（可选）----------
# DEFAULT_PROVIDER_ID=qwen3.7-max

# ---------- 账号认证（JWT + Argon2id，必填：JWT_SECRET_KEY）----------
# JWT 签名密钥（必填，无默认有效值；缺失时后端启动抛 ConfigError）
JWT_SECRET_KEY=
# 以下各项走 compose 内置默认值，需要改就取消注释覆盖
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=10080
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=4

# ---------- 账号资料（头像 / 密码，走 compose 内置默认值）----------
# 修改密码新密码最短长度
# ACCOUNT_PASSWORD_MIN_LENGTH=8
# 头像上限（字节，默认 2 MiB）
# AVATAR_MAX_SIZE_BYTES=2097152
# 头像允许扩展名
# AVATAR_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif
# 头像边长上限 / 下限（像素）
# AVATAR_MAX_DIMENSION=512
# AVATAR_MIN_DIMENSION=32

# ---------- 会话记忆（可选，走 compose 默认值 50）----------
# 续聊恢复上下文时从 messages 加载的最近回合上限（条）
# HISTORY_MAX_MESSAGES=50
