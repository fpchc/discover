{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 FastAPI: 启动服务 (无 reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "9101",
        "--log-level",
        "debug"
      ],
      "jinja": true,
      "justMyCode": false,
      "env": {
        "LOG_LEVEL": "DEBUG"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "🛰️ 腾讯联网 MCP 服务 (tencent_mcp)",
      "type": "debugpy",
      "request": "launch",
      "module": "local_mcp.tencent_mcp.main",
      "jinja": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "internalConsole"
    },
    {
      "name": "🛰️ 东财 MCP 服务 (eastmoney_mcp)",
      "type": "debugpy",
      "request": "launch",
      "module": "local_mcp.eastmoney_mcp.main",
      "jinja": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "🧩 主应用 + MCP Servers（全部）",
      "configurations": [
        "🛰️ 腾讯联网 MCP 服务 (tencent_mcp)",
        "🛰️ 东财 MCP 服务 (eastmoney_mcp)",
        "🚀 FastAPI: 启动服务 (无 reload)"
      ],
      "stopAll": true,
      "presentation": {
        "group": "1 组合启动",
        "order": 1
      }
    },
    {
      "name": "MCP Servers（全部）",
      "configurations": [
        "🛰️ 腾讯联网 MCP 服务 (tencent_mcp)",
        "🛰️ 东财 MCP 服务 (eastmoney_mcp)",
      ],
      "stopAll": true,
      "presentation": {
        "group": "2 mcp组合启动",
        "order": 2
      }
    }
  ]
}
