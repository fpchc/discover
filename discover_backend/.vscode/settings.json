{
  // ---- 解释器：绑定项目内 .venv（uv venv 创建） ----
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  // ---- 类型检查：交给 Mypy，关闭 Pylance 内建以免双重报错 ----
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  // ---- Mypy（复用 pyproject.toml 的 strict 配置） ----
  "mypy-type-checker.args": [
    "--config-file=${workspaceFolder}/pyproject.toml"
  ],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  // ---- Ruff（Lint + Format，替代 black/isort/flake8） ----
  "ruff.importStrategy": "fromEnvironment",
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",
  // ---- Python 文件保存行为：Ruff 格式化 + 自动修复 + import 整理 ----
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.rulers": [
      100
    ],
    "editor.tabSize": 4
  },
  // ---- Pytest（asyncio_mode=auto 已在 pyproject 配置） ----
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ],
  // ---- 编辑器通用约束 ----
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  // ---- YAML / TOML / JSON 缩进 ----
  "[yaml]": {
    "editor.tabSize": 2
  },
  "[toml]": {
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  // ---- 文件浏览器隐藏构建产物 / 缓存 ----
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "**/.venv": false
  },
  // ---- 搜索排除：不检索依赖与产物 ----
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/logs": true,
    "**/migrations/versions/*.py": false
  },
  // ---- 文件监视排除：降低资源占用 ----
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/logs/**": true
  },
  // ---- 敏感文件保护：标记为只读，避免误改 ----
  "files.readonlyInclude": {
    // "**/.env": true
  }
}
