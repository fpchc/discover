# ---------- 基础路径 ----------
# 智能体包根目录
AGENTS_ROOT_DIR=agents
# MCP 服务注册表路径
MCP_REGISTRY_PATH=config/mcp-servers.yaml
# 模型提供方注册表路径
LLM_PROVIDERS_PATH=config/llm-providers.yaml
# 智能体工作区根目录（按 agent 键控，跨会话共享）
AGENT_WORKSPACE_ROOT_DIR=workspaces

# ---------- 数据库与持久化 (PostgreSQL) ----------
# SQLAlchemy 异步连接串（asyncpg 驱动）。
# 本地默认 127.0.0.1 而非 localhost：Windows+Docker 下 IPv6 回环转发超时。
DB_USERNAME=postgres
DB_PASSWORD=v7Hf
DB_HOST=175.178.45.21
DB_PORT=5432
DB_DATABASE=agent_platform
# 连接池（可选，默认即开即用）：复用连接显著降低远程 DB 每次操作的建连延迟
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30.0
# DB_POOL_PRE_PING=true
# DB_POOL_RECYCLE_SECONDS=1800

# ---------- 缓存与连接锁 (Redis) ----------
# redis 插件（恒启用：认证会话层硬依赖，登录会话/过期/撤销/续期以 Redis 为准）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_DEFAULT_TTL_SECONDS=3600
REDIS_LOCK_DEFAULT_TIMEOUT_SECONDS=30

# ---------- 文件与存储 (Blob Engine) ----------
# 本地存储根目录（UUID 扁平，无目录层级；S3/OSS/COS 为后续扩展点）
STORAGE_ROOT_DIR=storage
# 存储后端："local" 本地磁盘；"s3" 为后续扩展点（本次未实现）
STORAGE_BACKEND=local
# 单个产物文件大小上限（字节），防脚本产出巨型文件
ARTIFACT_MAX_SIZE_BYTES=104857600

# ---------- 大语言模型 (LLM) ----------
# 默认模型提供方标识（一级路由与通用对话用）
DEFAULT_PROVIDER_ID=qwen3.7-max
# 模型接入密钥（密文，仅环境变量，不入配置）
LLM_API_KEY=
# LLM 三套独立超时（秒）：连接 / 分片间隔（读） / 总时长
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=300
# 错误消息截断上限（字符）
ERROR_MESSAGE_MAX_CHARS=500
# 思考模式开关
THINKING_ENABLED=true

# ---------- 工具与 MCP 服务 ----------
# 单批工具并发上限（全局闸门）
TOOL_BATCH_CONCURRENCY=10
# 工具默认超时（秒）
TOOL_DEFAULT_TIMEOUT_SECONDS=30
# 工具输出截断上限（字符）
TOOL_OUTPUT_TRUNCATE_CHARS=6000
# MCP 必需依赖获取重试：本地 MCP 服务启动慢时短暂不可用不直接拒绝激活
MCP_ACQUIRE_RETRY_ATTEMPTS=3
MCP_ACQUIRE_RETRY_BACKOFF_SECONDS=1.5
# MCP 泛化分发工具名
MCP_HIDDEN_TOOL_NAMES=["call_tool", "call_tools_batch"]
# 本地自建腾讯联网搜索 MCP
TENCENT_MCP_TOKEN=
WSA_API_KEY=
TENCENT_MCP_HOST=127.0.0.1
TENCENT_MCP_PORT=9111
# 本地自建东方财富 MCP
EASTMONEY_MCP_TOKEN=
EASTMONEY_MCP_HOST=127.0.0.1
EASTMONEY_MCP_PORT=9112
# 专有数据源令牌
ALIBABA_SEARCH_TOKEN=
TYC_MCP_TOKEN=
QCC_MCP_TOKEN=
TUSHARE_MCP_TOKEN=

# ---------- 智能体与运行时 (Agent Runtime) ----------
# 装配限制
AGENT_BODY_MAX_CHARS=2000
SKILL_BODY_MAX_CHARS=8000
# 推理与路由
CONTEXT_BUDGET_TOKENS=96000
REASONING_MAX_TURNS=40
HISTORY_MAX_MESSAGES=50
# Bounded ReAct 运行预算上限
AGENT_MAX_ITERATIONS=20
AGENT_MAX_LLM_CALLS=30
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_TOTAL_TOKENS=150000
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_DURATION_SECONDS=300
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_FINALIZATION_RESERVE_TOKENS=5000
# 历史上下文摘要
AGENT_CONTEXT_SUMMARY_MAX_MESSAGES=10
AGENT_CONTEXT_SUMMARY_MAX_CHARS=4000

# ---------- 流式传输与交互 (SSE & Console) ----------
# SSE 打字机（正文）
TYPEWRITER_FRAME_INTERVAL_MS=30
TYPEWRITER_CHARS_PER_FRAME=2
TYPEWRITER_CATCHUP_THRESHOLD=200
TYPEWRITER_CATCHUP_RATIO=4
# SSE 打字机（思考）
THINKING_FRAME_INTERVAL_MS=20
THINKING_CHARS_PER_FRAME=4
# SSE 心跳与队列
SSE_HEARTBEAT_INTERVAL_SECONDS=15
SSE_QUEUE_MAX_EVENTS=128
ACTIVE_TURN_TTL_SECONDS=120
# 控制台客户端配置
CONSOLE_BASE_URL=http://127.0.0.1:9101
CONSOLE_CHAR_DELAY_MS=20
CONSOLE_REQUEST_TIMEOUT_SECONDS=300

# ---------- 认证与账号安全 (JWT / Password / SSO) ----------
# JWT 签名与验签配置
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=crm-auth
JWT_AUDIENCE=crm-backend
AUTH_ACCESS_TOKEN_TTL_SECONDS=604800
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Argon2id 加密参数
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
# 账号资料与头像
ACCOUNT_PASSWORD_MIN_LENGTH=8
AVATAR_MAX_SIZE_BYTES=2097152
AVATAR_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif
AVATAR_MAX_DIMENSION=512
AVATAR_MIN_DIMENSION=32
# 公司统一登录 (elecnest SSO)
ELECNEST_SSO_ENABLED=true
ELECNEST_GET_USER_INFO_URL=https://id.elecnest.cn/api/login/getUserInfo
ELECNEST_SSO_TIMEOUT_SECONDS=10

# ---------- 服务与日志 (Service & Logging) ----------
HOST=0.0.0.0
PORT=9101
LOG_LEVEL=INFO
REQUEST_LOGGING_ENABLED=true
# 日志扩展配置
LOG_OUTPUT_FORMAT=text
LOG_TZ=Asia/Shanghai
LOG_DIR=logs
LOG_FILE=app.log
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_INTERVAL=1
LOG_FILE_BACKUP_COUNT=14
LOG_COMPRESS=true
# LOG_MODULE_LEVELS={}

# ---------- 系统开关与插件 (Features & Plugins) ----------
# 功能热重载
HOT_RELOAD_ENABLED=false
HOT_RELOAD_INTERVAL_SECONDS=30
# 插件开关（插件系统统一加载）
LOGGING_ENABLED=true
DB_ENABLED=true
STORAGE_ENABLED=true
MCP_ENABLED=true
LLM_ENABLED=true
