# ============================================================
# 平台配置样例（仓库唯一允许提交的 env 文件）
# 复制为 .env 后按需修改。真实密钥只在 .env / 环境变量中提供，
# 严禁提交。字段与默认值定义见 app/config/settings.py。
# ============================================================

# ---------- 路径 ----------
# 智能体包根目录
AGENTS_ROOT_DIR=agents
# MCP 服务注册表路径
MCP_REGISTRY_PATH=config/mcp-servers.yaml
# 模型提供方注册表路径
LLM_PROVIDERS_PATH=config/llm-providers.yaml
# 智能体工作区根目录（按 agent 键控，跨会话共享）
AGENT_WORKSPACE_ROOT_DIR=workspaces

# ---------- 持久化（PostgreSQL） ----------
# SQLAlchemy 异步连接串（asyncpg 驱动）。
# 本地默认 127.0.0.1 而非 localhost：Windows+Docker 下 IPv6 回环转发超时。
DB_USERNAME=postgres
DB_PASSWORD=v7Hf
DB_HOST=175.178.45.21
DB_PORT=5432
DB_DATABASE=agent_platform


# ---------- 存储（Blob Engine） ----------
# 本地存储根目录（UUID 扁平，无目录层级；S3/OSS/COS 为后续扩展点）
STORAGE_ROOT_DIR=storage

# ---------- LLM ----------
# 默认模型提供方标识（一级路由与通用对话用）
DEFAULT_PROVIDER_ID=qwen3.7-max
# 模型接入密钥（密文，仅环境变量，不入配置）
LLM_API_KEY=
# LLM 三套独立超时（秒）：连接 / 分片间隔（读） / 总时长
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=300
# 错误消息截断上限（字符）
ERROR_MESSAGE_MAX_CHARS=500

# ---------- 思考模式 ----------
THINKING_ENABLED=true

# ---------- SSE 打字机（正文） ----------
TYPEWRITER_FRAME_INTERVAL_MS=30
TYPEWRITER_CHARS_PER_FRAME=2
TYPEWRITER_CATCHUP_THRESHOLD=200
TYPEWRITER_CATCHUP_RATIO=4

# ---------- SSE 打字机（思考：通常更长，可更快推送） ----------
THINKING_FRAME_INTERVAL_MS=20
THINKING_CHARS_PER_FRAME=4

# ---------- SSE 心跳 ----------
SSE_HEARTBEAT_INTERVAL_SECONDS=15
# SSE 事件队列上限（背压：满时增量合并、心跳丢弃、关键事件等待）
SSE_QUEUE_MAX_EVENTS=128

# ---------- 控制台客户端 ----------
# 对话控制台连接的服务地址
CONSOLE_BASE_URL=http://127.0.0.1:8000
# 控制台打字机：每字素延迟（毫秒），0 表示整段直接输出
CONSOLE_CHAR_DELAY_MS=20
# 控制台请求超时（秒）
CONSOLE_REQUEST_TIMEOUT_SECONDS=300

# ---------- 工具 ----------
# 单批工具并发上限（全局闸门）
TOOL_BATCH_CONCURRENCY=10
# 工具默认超时（秒）
TOOL_DEFAULT_TIMEOUT_SECONDS=30
# 工具输出截断上限（字符）
TOOL_OUTPUT_TRUNCATE_CHARS=6000
# 工具完整输出日志根目录（审计与前端取回原文）
TOOL_LOG_ROOT_DIR=logs/tools

# ---------- MCP ----------
# 阿里百炼搜索令牌（密文，仅环境变量）
ALIBABA_SEARCH_TOKEN=

# ---------- 会话与产物 ----------
# 单个产物文件大小上限（字节），防脚本产出巨型文件
ARTIFACT_MAX_SIZE_BYTES=104857600

# ---------- 推理与路由 ----------
# 单轮上下文预算（token）
CONTEXT_BUDGET_TOKENS=96000
# 推理循环轮次上限
REASONING_MAX_TURNS=40
# 路由置信度阈值（0~1）
ROUTING_CONFIDENCE_THRESHOLD=0.6

# ---------- 装配（智能体清单） ----------
# AGENT 正文上限（字符）
AGENT_BODY_MAX_CHARS=2000
# SKILL 正文上限（字符）
SKILL_BODY_MAX_CHARS=8000

# ---------- 功能开关（{module}_enabled 命名） ----------
# 热重载开关：监听智能体包变更
HOT_RELOAD_ENABLED=false
# 热重载轮询间隔（秒）
HOT_RELOAD_INTERVAL_SECONDS=30

# ---------- 插件开关（{plugin}_enabled 命名，插件系统统一加载） ----------
# logging / db / storage / mcp / llm 默认开启；redis 为新增能力，默认关闭
LOGGING_ENABLED=true
DB_ENABLED=true
STORAGE_ENABLED=true
MCP_ENABLED=true
LLM_ENABLED=true
REDIS_ENABLED=false

# ---------- logging 插件 ----------
# 日志格式："text" 明文行 / "json" 结构化单行
LOG_FORMAT=text
# 日志落盘目录；留空表示仅控制台输出
# LOG_DIR=logs

# ---------- redis 插件（REDIS_ENABLED=true 时生效） ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_DEFAULT_TTL_SECONDS=3600
REDIS_LOCK_DEFAULT_TIMEOUT_SECONDS=30

# ---------- storage 插件 ----------
# 存储后端："local" 本地磁盘；"s3" 为后续扩展点（本次未实现）
STORAGE_BACKEND=local

# ---------- 中间件 ----------
# 请求日志中间件开关（全局异常中间件始终启用，替换内联异常处理器）
REQUEST_LOGGING_ENABLED=true

# ---------- 服务 ----------
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
