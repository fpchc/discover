# ============================================================
# 平台配置样例（仓库唯一允许提交的 env 文件）
# 复制为 .env 后按需修改。真实密钥只在 .env / 环境变量中提供，
# 严禁提交。字段与默认值定义见 app/config/settings.py。
# ============================================================

# ---------- 路径 ----------
# 智能体包根目录
AGENTS_ROOT_DIR=agents
# MCP 服务注册表路径
MCP_REGISTRY_PATH=config/mcp-servers.yaml
# 模型提供方注册表路径
LLM_PROVIDERS_PATH=config/llm-providers.yaml
# 智能体工作区根目录（按 agent 键控，跨会话共享）
AGENT_WORKSPACE_ROOT_DIR=workspaces

# ---------- 持久化（PostgreSQL） ----------
# SQLAlchemy 异步连接串（asyncpg 驱动）。
# 本地默认 127.0.0.1 而非 localhost：Windows+Docker 下 IPv6 回环转发超时。
DB_USERNAME=postgres
DB_PASSWORD=v7Hf
DB_HOST=175.178.45.21
DB_PORT=5432
DB_DATABASE=agent_platform


# ---------- 存储（Blob Engine） ----------
# 本地存储根目录（UUID 扁平，无目录层级；S3/OSS/COS 为后续扩展点）
STORAGE_ROOT_DIR=storage

# ---------- LLM ----------
# 默认模型提供方标识（一级路由与通用对话用）
DEFAULT_PROVIDER_ID=qwen3.7-max
# 模型接入密钥（密文，仅环境变量，不入配置）
LLM_API_KEY=
# LLM 三套独立超时（秒）：连接 / 分片间隔（读） / 总时长
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=300
# 错误消息截断上限（字符）
ERROR_MESSAGE_MAX_CHARS=500

# ---------- 思考模式 ----------
THINKING_ENABLED=true

# ---------- SSE 打字机（正文） ----------
TYPEWRITER_FRAME_INTERVAL_MS=30
TYPEWRITER_CHARS_PER_FRAME=2
TYPEWRITER_CATCHUP_THRESHOLD=200
TYPEWRITER_CATCHUP_RATIO=4

# ---------- SSE 打字机（思考：通常更长，可更快推送） ----------
THINKING_FRAME_INTERVAL_MS=20
THINKING_CHARS_PER_FRAME=4

# ---------- SSE 心跳 ----------
SSE_HEARTBEAT_INTERVAL_SECONDS=15
# SSE 事件队列上限（背压：满时增量合并、心跳丢弃、关键事件等待）
SSE_QUEUE_MAX_EVENTS=128

# ---------- 控制台客户端 ----------
# 对话控制台连接的服务地址
CONSOLE_BASE_URL=http://127.0.0.1:8000
# 控制台打字机：每字素延迟（毫秒），0 表示整段直接输出
CONSOLE_CHAR_DELAY_MS=20
# 控制台请求超时（秒）
CONSOLE_REQUEST_TIMEOUT_SECONDS=300

# ---------- 工具 ----------
# 单批工具并发上限（全局闸门）
TOOL_BATCH_CONCURRENCY=10
# 工具默认超时（秒）
TOOL_DEFAULT_TIMEOUT_SECONDS=30
# 工具输出截断上限（字符）
TOOL_OUTPUT_TRUNCATE_CHARS=6000
# 工具完整输出日志根目录（仅截断的超长输出落盘，前端经 log_path 取回原文）
TOOL_LOG_ROOT_DIR=logs/tools
# 工具日志保留天数（>0 时新会话激活即清扫超期目录；<=0 不清理）
TOOL_LOG_RETENTION_DAYS=7
# 单会话工具日志文件数上限（达到后停止落盘，防极端场景撑爆磁盘）
TOOL_LOG_MAX_FILES_PER_SESSION=200

# ---------- MCP ----------
# 本地自建腾讯联网搜索 MCP（local_mcp/tencent_mcp 包，python -m local_mcp.tencent_mcp.main 启动）：
#   TENCENT_MCP_TOKEN = 平台连接本服务的 Bearer 令牌（平台 mcp-servers.yaml 的 tencent_mcp 引用）
#   WSA_API_KEY       = 腾讯 WSA 联网搜索 API Key（tencent_mcp 出站调腾讯用）
TENCENT_MCP_TOKEN=
WSA_API_KEY=
# tencent_mcp 服务监听地址（本地默认 127.0.0.1:10001；docker 内须 TENCENT_MCP_HOST=0.0.0.0）。
# 平台注册表 base_url 由 TENCENT_MCP_BASE_URL 覆盖（docker 里设为 http://tencent_mcp:10001/mcp）。
TENCENT_MCP_HOST=127.0.0.1
TENCENT_MCP_PORT=10001
# 本地自建东方财富 MCP（local_mcp/eastmoney_mcp 包，python -m local_mcp.eastmoney_mcp.main 启动，出站免鉴权）：
#   EASTMONEY_MCP_TOKEN = 平台连接本服务的 Bearer 令牌（平台 mcp-servers.yaml 的 eastmoney_mcp 引用）
EASTMONEY_MCP_TOKEN=
# eastmoney_mcp 服务监听地址（本地默认 127.0.0.1:10002；docker 内须 EASTMONEY_MCP_HOST=0.0.0.0）。
# 平台注册表 base_url 由 EASTMONEY_MCP_BASE_URL 覆盖（docker 里设为 http://eastmoney_mcp:10002/mcp）。
EASTMONEY_MCP_HOST=127.0.0.1
EASTMONEY_MCP_PORT=10002
ALIBABA_SEARCH_TOKEN=
# 专有数据源令牌（密文，仅环境变量）。未设置时对应能力（enterprise_business / enterprise_risk /
# financial_data）在装配时自动降级为 web_search，不影响激活。对应服务器见 config/mcp-servers.yaml
TYC_MCP_TOKEN=
QCC_MCP_TOKEN=
TUSHARE_MCP_TOKEN=

# ---------- 会话与产物 ----------
# 单个产物文件大小上限（字节），防脚本产出巨型文件
ARTIFACT_MAX_SIZE_BYTES=104857600

# ---------- 推理与路由 ----------
# 单轮上下文预算（token）
CONTEXT_BUDGET_TOKENS=96000
# 推理循环轮次上限
REASONING_MAX_TURNS=40

# ---------- 会话记忆（历史上下文恢复） ----------
# 续聊恢复上下文时从 messages 加载的最近回合上限（条）
HISTORY_MAX_MESSAGES=50

# ---------- 装配（智能体清单） ----------
# AGENT 正文上限（字符）
AGENT_BODY_MAX_CHARS=2000
# SKILL 正文上限（字符）
SKILL_BODY_MAX_CHARS=8000

# ---------- 功能开关（{module}_enabled 命名） ----------
# 热重载开关：监听智能体包变更
HOT_RELOAD_ENABLED=false
# 热重载轮询间隔（秒）
HOT_RELOAD_INTERVAL_SECONDS=30

# ---------- 插件开关（{plugin}_enabled 命名，插件系统统一加载） ----------
# logging / db / storage / mcp / llm 默认开启；redis 恒启用（认证会话层硬依赖，无开关）
LOGGING_ENABLED=true
DB_ENABLED=true
STORAGE_ENABLED=true
MCP_ENABLED=true
LLM_ENABLED=true

# ---------- logging 扩展 ----------
# 输出格式："text" 明文行 / "json" 结构化单行
LOG_OUTPUT_FORMAT=text
# 日志时区（IANA 名称）
LOG_TZ=Asia/Shanghai
# 日志目录与文件名（RotatingFileHandler）
LOG_DIR=logs
LOG_FILE=app.log
# 单文件轮转上限（MB）
LOG_FILE_MAX_SIZE=10
# 轮转备份数
LOG_FILE_BACKUP_COUNT=5
# 模块级日志级别覆盖：JSON 映射，如 {"app.tools.broker": "DEBUG"}
# LOG_MODULE_LEVELS={}

# ---------- redis 插件（恒启用：认证会话层硬依赖，登录会话/过期/撤销/续期以 Redis 为准） ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_DEFAULT_TTL_SECONDS=3600
REDIS_LOCK_DEFAULT_TIMEOUT_SECONDS=30

# ---------- storage 插件 ----------
# 存储后端："local" 本地磁盘；"s3" 为后续扩展点（本次未实现）
STORAGE_BACKEND=local

# ---------- 中间件 ----------
# 请求日志中间件开关（全局异常中间件始终启用，替换内联异常处理器）
REQUEST_LOGGING_ENABLED=true

# ---------- 服务 ----------
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ---------- 账号认证（手机号+密码登录，JWT + Argon2id） ----------
# JWT 签名密钥（必填，无默认有效值；缺失时服务启动抛 ConfigError）
JWT_SECRET_KEY=
# 签名算法
JWT_ALGORITHM=HS256
# 访问令牌有效期（秒）：JWT exp 与 Redis 访问会话 TTL 对齐（Redis 为准；默认 24 小时，
# 到期后前端经 /auth/refresh 用刷新令牌续期）
AUTH_ACCESS_TOKEN_TTL_SECONDS=86400
# 刷新令牌有效期（秒）：Redis 刷新会话 TTL（权威；默认 7 天，到期/轮换/登出需重新登录）
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Argon2id 参数（OWASP 推荐强度：64 MiB、3 次迭代、4 并行）
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ---------- 账号资料（头像 / 密码） ----------
# 修改密码新密码最短长度
ACCOUNT_PASSWORD_MIN_LENGTH=8
# 头像上限（字节，默认 2 MiB；显示目标：侧栏 32px / 资料弹窗 ~96px 圆形）
AVATAR_MAX_SIZE_BYTES=2097152
# 头像允许扩展名（服务端另做 magic bytes 内容校验，防改名伪装）
AVATAR_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif
# 头像边长上限 / 下限（像素）
AVATAR_MAX_DIMENSION=512
AVATAR_MIN_DIMENSION=32

# ---------- 公司统一登录（elecnest SSO） ----------
# 开关：默认开启；关闭后 /auth/login/elecnest 返回 400（未启用）
ELECNEST_SSO_ENABLED=true
# 统一登录用户信息接口（token + uid → 用户资料）
ELECNEST_GET_USER_INFO_URL=https://id.elecnest.cn/api/login/getUserInfo
# 外部 HTTP 调用超时（秒）
ELECNEST_SSO_TIMEOUT_SECONDS=10
