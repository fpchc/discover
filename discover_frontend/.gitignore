# ---- 依赖 / 构建产物 ----
node_modules/
dist/
dist-ssr/
.nuxt/
.output/
.data/
*.local

# ---- 类型检查 / 静态分析 / 测试 ----
coverage/
.vite/
*.tsbuildinfo

# ---- 环境与密钥（无密钥的环境模板允许提交：env/.env.example / env/.env.development / env/.env.test / env/.env.production）----
# 根仓库 .gitignore 有 `.env.*` 兜底，此处用 `!` 仅放行模板
.env
.env.local
env/.env.local
env/.env.*.local
!env/.env.example
!env/.env.development
!env/.env.test
!env/.env.production
*.pem
*.key

# ---- IDE（团队共享配置随仓库提交，个人配置仍忽略）----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
