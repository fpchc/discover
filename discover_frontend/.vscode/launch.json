{
  "version": "0.2.0",
  "configurations": [
    {
      // 启动 Nuxt dev server（preLaunchTask）后打开 Chrome 调试
      "type": "chrome",
      "request": "launch",
      "name": "Debug in Chrome (Nuxt)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev: Nuxt dev server"
    },
    {
      // 同 Chrome，浏览器换成 Edge
      "type": "msedge",
      "request": "launch",
      "name": "Debug in Edge (Nuxt)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev: Nuxt dev server"
    },
    {
      // 直接以 node 方式跑 Vitest，可在测试内打断点
      "type": "node",
      "request": "launch",
      "name": "Vitest (run)",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run"],
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
