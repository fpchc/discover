{
  "name": "discover-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT 风格单页对话应用（消费 discover_backend 多智能体平台）",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "nuxt dev --dotenv ./env/.env.development",
    "dev:test": "nuxt dev --dotenv ./env/.env.test",
    "build": "nuxt typecheck && nuxt generate --dotenv ./env/.env.production",
    "build:test": "nuxt typecheck && nuxt generate --dotenv ./env/.env.test",
    "preview": "vite preview --port 4173",
    "typecheck": "nuxt typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@pinia/nuxt": "^1.0.2",
    "axios": "^1.8.4",
    "dompurify": "^3.2.4",
    "element-plus": "^2.9.7",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "dayjs": "^1.11.23",
    "happy-dom": "^18.0.1",
    "lodash-unified": "^1.0.3",
    "typescript": "~5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.1"
  }
}
