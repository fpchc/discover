# 环境模板（无密钥，可提交）。实际值放 env/.env.{development,test,production}
# 或本地 env/.env.*.local（gitignore 排除）。禁止硬编码 URL / 密钥 / 超时 / 阈值。

# 应用环境（与 vite mode 正交）：development | test | production
VITE_APP_ENV=development

# 后端 API base URL（含 /api/v1 前缀；同源部署用相对路径，dev 走 vite 代理）
VITE_API_BASE_URL=/api/v1

# SSE 流式请求整体超时（毫秒）；长思考 / 工具调用流建议 ≥ 15 分钟
VITE_SSE_TIMEOUT_MS=900000

# 普通 HTTP（blocking / 历史 / 文件）请求超时（毫秒）
VITE_REQUEST_TIMEOUT_MS=30000

# 用户 query 长度上限（对齐后端 ChatMessageRequest.max_length）
VITE_CHAT_QUERY_MAX=4000

# 会话标题取首条用户消息的最大字符数
VITE_CONVERSATION_TITLE_MAX=20

# dev 代理目标后端（仅 vite dev 使用，见 vite.config.ts）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 功能开关
VITE_FEATURE_THINKING=true
VITE_FEATURE_TOOL_CALLS=true
VITE_FEATURE_ARTIFACTS=true
VITE_FEATURE_FILES=true

# 阻塞兜底开关（流式失败后可切 blocking 模式重试）
VITE_FEATURE_BLOCKING_FALLBACK=true
